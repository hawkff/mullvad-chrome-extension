{
  "manifest_version": 3,
  "name": "Mullvad Proxy — Unofficial",
  "version": "0.1.0",
  "description": "Unofficial Mullvad VPN companion for Chrome. Requires an existing Mullvad VPN connection.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background/index.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "proxy", "activeTab"],
  "optional_permissions": ["privacy"],
  "host_permissions": [
    "https://api.mullvad.net/*",
    "https://ipv4.am.i.mullvad.net/*",
    "https://ipv6.am.i.mullvad.net/*",
    "https://*.dnsleak.am.i.mullvad.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "incognito": "spanning"
}
